# Copy to .env and change. .env is git-ignored.
POSTGRES_DB=pantry
POSTGRES_USER=pantry
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
APP_PORT=8080
# Passkeys (ADR 0004, 0014): relying party ID is the hostname the app is opened on, origin is the full URL (scheme, host, port).
PASSKEY_RP_ID=localhost
PASSKEY_ORIGIN=http://localhost:8080
# How long a sign-in lasts without use (d.hh:mm:ss).
SESSION_LIFETIME=30.00:00:00
